# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Database Configuration
PORT=3000
# Optional external MongoDB connection string (e.g. mongodb://localhost:27017/staffsync or MongoDB Atlas).
# If left empty, StaffSync automatically initializes an embedded MongoDB engine.
MONGODB_URI=""

# JWT Security
JWT_SECRET="staffsync_enterprise_secret_jwt_key_2026_super_secure"
JWT_EXPIRE="7d"
